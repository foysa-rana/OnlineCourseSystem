
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/client/_Layout.cshtml";
}


<!-- main -->
<main>
    <!-- header -->
    <section class="header">
        <!-- banner -->
        <section class="banner overlay">
            <div class="container">
                <div class="wrapper d-flex flex-column justify-content-center">
                    <h2 class="text-white">
                        Welcome
                        <span class="d-block mt-1">
                            <span class="fw-normal">To</span>
                            <span class="text-warning Permanent-Marker">Techvally</span>
                        </span>
                    </h2>
                    <p class="text-white">
                        <span class="d-block">Beleive Yourself,</span>
                        <span class="d-block">Continue With Us,</span>
                        <span class="d-block">For Successful Career.</span>
                    </p>
                </div>
            </div>
        </section>
        <!-- end of banner -->
    </section>
    <!-- end of header -->
    <!-- recent courses -->
    <section class="recent-courses">
        <div class="container">
            <div class="row mt-4">
                <!-- content header -->
                <div class="content-header">
                    <h2 class="text-center fw-semibold">
                        Recent <span>Courses</span>
                    </h2>
                </div>
                <!-- end of content header -->
                <div class="content-body position-relative">
                    <p class="text-center mt-2">
                        Lorem ipsum, dolor sit amet consectetur adipisicing elit. Odio
                        facere ipsam quasi vero, aspernatur et.
                    </p>
                    <div class="all-items swiper swiper-horizontal">
                        <!-- all recent item will be show here-->
                        <div class="swiper-wrapper" id="recent-course-item">
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                    <a href=@Url.Action("AllCourse", "CourseList") class="view-all btn custom-btn">
                        View All Courses<i class="ri-arrow-right-line"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <!-- end of recent courses -->
    <!-- popular courses -->
    <section class="popular-courses">
        <div class="container">
            <div class="row mt-4">
                <!-- content header -->
                <div class="content-header">
                    <h2 class="text-center fw-semibold">
                        Popular <span>Courses</span>
                    </h2>
                </div>
                <!-- end of content header -->
                <!-- content body -->
                <div class="content-body position-relative">
                    <p class="text-center mt-2">
                        Lorem ipsum, dolor sit amet consectetur adipisicing elit. Odio
                        facere ipsam quasi vero, aspernatur et.
                    </p>
                    <div class="all-items swiper swiper-horizontal">
                        <!-- all popular item will be show here-->
                        <div class="swiper-wrapper" id="popular-course-item"></div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                    <a href=@Url.Action("AllCourse", "CourseList") class="view-all btn custom-btn">
                        View All Courses<i class="ri-arrow-right-line"></i>
                    </a>
                </div>
                <!-- end of contetn body -->
            </div>
        </div>
    </section>
    <!-- end of popular courses -->
    <!-- seminar -->
    <section class="seminar">
        <div class="container">
            <div class="row mt-4">
                <!-- content header -->
                <div class="content-header">
                    <h2 class="text-center fw-semibold">
                        Upcoming <span>Seminar</span>
                    </h2>
                </div>
                <!-- content body -->
                <div class="content-body">
                    <p class="text-center mt-2">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Facere,
                        dolore.
                    </p>
                    <div class="swiper swiper-seminar">
                        <!-- all seminar item will be show here-->
                        <div class="swiper-wrapper" id="seminar-item"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
                <!-- end of content body -->
            </div>
        </div>
    </section>
    <!-- end of seminar -->
    <!-- trainer information -->
    <section class="trainer-info">
        <div class="container">
            <div class="row mt-4">
                <!-- content header -->
                <div class="content-header">
                    <h2 class="text-center fw-semibold">
                        Trainer <span>Information</span>
                    </h2>
                </div>
                <!-- content body -->
                <div class="content-body position-relative">
                    <p class="text-center mt-2">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Facere,
                        dolore.
                    </p>
                    <!-- all trainer item will be show here-->
                    <div class="d-grid" id="trainer-item"></div>
                    
                </div>
            </div>
        </div>
    </section>
    <!-- end of trainer information -->
</main>
<!-- end of main -->
<!-- footer -->
<footer class="bg-dark pt-3">


@section ViewSpecificJavascript
{
    <script src="~/Scripts/client/js/loadData.js"></script>
}
