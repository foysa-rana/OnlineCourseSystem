<body>
    <!-- sign up modal -->
    <section class="modal-section sign-modal-section">
        <div class="container">
            <div class="wrapper">
                <!-- Modal -->
                <div class="modal fade"
                     id="sign-modal"
                     tabindex="-1"
                     aria-labelledby="signModalLabel"
                     aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4>Log In to Continue</h4>
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="signin-signup-btn d-flex justify-content-around">
                                    <button class="sign-btn custom-sign-btn sign-in-btn active">
                                        Sign In
                                    </button>
                                    <button class="sign-btn custom-sign-btn sign-up-btn">
                                        Sign Up
                                    </button>
                                </div>
                                <div class="signin show">
                                    <form action="">
                                        <div class="form-group">
                                            <div class="form-icon">
                                                <i class="ri-user-line"></i>
                                                <input class="w-100"
                                                       type="text"
                                                       name="user"
                                                       id="User"
                                                       placeholder="username or email" />
                                            </div>
                                            <div class="form-icon">
                                                <i class="ri-lock-line"></i>
                                                <input class="w-100"
                                                       type="password"
                                                       name="password"
                                                       id="PasswordSignIn"
                                                       placeholder="password" />
                                            </div>
                                        </div>
                                        <div class="form-group remeber-group">
                                            <div class="check">
                                                <input type="checkbox"
                                                       name="remember"
                                                       id="Remember" />
                                                <label class="remember" for="Remember">Remember Me</label>
                                            </div>
                                            <a href="#" class="nav-link forgot">Forgot Password</a>
                                        </div>
                                        <button id="signIn" class="sign-btn sign-submit mt-4" type="button">
                                            Sign In
                                        </button>
                                    </form>
                                </div>
                                <div class="signup">
                                    <form action="">
                                        <div class="form-group">
                                            <input class="w-100"
                                                   type="text"
                                                   name="username"
                                                   id="UserName"
                                                   placeholder="Username" />
                                            <p class="small user-name-validation d-none">Username already exist</p>
                                            <input class="w-100"
                                                   type="text"
                                                   name="fname"
                                                   id="FName"
                                                   placeholder="First name" />
                                            <input class="w-100"
                                                   type="text"
                                                   name="lname"
                                                   id="LName"
                                                   placeholder="Last name" />
                                            <div class="form-row form-row-space">
                                                <div style="width: 48%">
                                                    <div class="position-relative">
                                                        <input class="w-100 js-datepicker"
                                                               type="text"
                                                               placeholder="Birthdate"
                                                               name="birthday"
                                                               id="BirthDate" />
                                                        <i class="zmdi zmdi-calendar-note input-icon js-btn-calendar"></i>
                                                    </div>
                                                </div>
                                                <div style="width: 48%">
                                                    <div class="w-100">
                                                        <select name="gender" id="Gender" class="w-100">
                                                            <option disabled="disabled" selected="selected">
                                                                Gender
                                                            </option>
                                                            <option>Male</option>
                                                            <option>Female</option>
                                                            <option>Other</option>
                                                        </select>
                                                        <div class="select-dropdown"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <input type="email"
                                                   name="email"
                                                   id="Email"
                                                   placeholder="Email" />
                                            <input type="password"
                                                   name="password"
                                                   id="Password"
                                                   placeholder="password" />
                                            <input type="password"
                                                   name="confirm-password"
                                                   id="confirm-password-SignUp"
                                                   placeholder="Confirm Password" />
                                            <p class="small password-confirmation d-none">Password did not matched.</p>
                                        </div>
                                        <button id="signUp" class="sign-btn sign-submit mt-4" type="button">
                                            Sign Up
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end of sign up modal -->
    <!-- topbar -->
    <section class="topbar">
