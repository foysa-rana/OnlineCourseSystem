    <script>
        //load popular courses
        let footerPopularCourses = async () => {
            let p = await fetch("/api/Course/GetAllOrderByDescending");
            let data = await p.json();
            let footerPopularCourses = document.querySelector('.footer-popular-courses');
            let storeFooterData = "";
            let count = 0;
            data.forEach((item, index) => {
                count++;
                if (count <= 10) {
                    storeFooterData +=
                        `<li>
                            <a href="/CourseView/Course?id=${item.id}" class="nav-link">
                                <i class="ri-check-double-line"></i> ${item.name}
                            </a>
                        </li>`;
                }

            });
            footerPopularCourses.innerHTML = storeFooterData;
        }
        footerPopularCourses();
    </script>
