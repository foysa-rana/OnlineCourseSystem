                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand fs-2 Permanent-Marker" href=@Url.Action("Index", "Home")>Techvally</a>
                <div class="offcanvas offcanvas-start flex-lg-row"
                     tabindex="-1"
                     id="offcanvasNavbar"
                     aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title Permanent-Marker"
                            id="offcanvasNavbarLabel">
                            Techvally
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas"
                                aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body mb-2 mb-lg-0 d-flex justify-content-between w-100">
                        <!-- left -->
                        <ul class="left navbar-nav flex-grow-1 pe-3">
                            <li>
                                <form class="mb-3 desktop-hide" role="search">
                                    <div class="form-group position-relative">
                                        <input class="form-control search search-mobile"
                                               type="search"
                                               placeholder="Search"
                                               aria-label="Search" />
                                        <button class="search-btn search-btn-mobile"
                                                type="button">
                                            <i class="ri-search-line"></i>
                                        </button>
                                    </div>
                                </form>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" aria-current="page" href=@Url.Action("Index", "Home")>Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href=@Url.Action("AllCourse", "CourseList")>Courses</a>
                            </li>
                            @*<li class="nav-item">
                                    <a class="nav-link" href="#">About</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Contact</a>
                                </li>*@
                        </ul>
                        <!-- end of left -->
                    </div>
                </div>
                <!-- right -->
                <ul class="right navbar-nav d-flex flex-row">
                    <!-- mobile-hide -->
                    <form class="me-4 mobile-hide position-relative" role="search">
                        <div class="form-group position-relative">
                            <input class="form-control search search-desktop"
                                   type="search"
                                   placeholder="Search"
                                   aria-label="Search" />
                            <span class="search-close hide">
                                <i class="ri-close-line fs-4"></i>
                            </span>
                            <button class="search-btn search-btn-desktop" type="button">
                                <i class="ri-search-line"></i>
                            </button>
                        </div>
                    </form>
                    @{
                        var controllerName = ViewContext.RouteData.Values["controller"].ToString();
                        var actionName = ViewContext.RouteData.Values["action"].ToString();
                        if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("User"))
                            {
                                <script>
                                let userAuthorized = true;
                                let userIdentity = "@User.Identity.Name.ToString()";
                                </script>
                                <li class="nav-item position-relative">
                                    <a class="nav-link profile">
                                        <div class="profile-img">
                                            <img src="../../Profile_image/blank-profile-picture.jpg" id="userProfileImg" alt="" />
                                        </div>
                                    </a>
                                    <ul class="profile-info">
                                        @*<li class="nav-item">
                                                <a href="" class="nav-link">
                                                    <span class="profile-icon">
                                                        <i class="ri-user-line"></i>
                                                    </span>
                                                    <span class="icon-text">Profile</span>
                                                </a>
                                            </li>*@
                                        <li class="nav-item position-relative">
                                            <a class="nav-link" id="nestedBtn">
                                                <span class="profile-icon">
                                                    <i class="ri-file-list-line"></i>
                                                </span>
                                                <span class="icon-text d-flex align-items-center">My Courses <i id="rightArrow" class="ri-arrow-right-s-line" style="font-size: 1.3rem; transform: rotate(0deg);"></i></span>
                                            </a>
                                            <ul class="nested-item" id="selectNested"></ul>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" id="logOut">
                                                <span class="profile-icon">
                                                    <i class="ri-logout-circle-line"></i>
                                                </span>
                                                <span class="icon-text">Logout</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <script>
                                    let userAuthorized = false;
                                </script>
                                <li class="nav-item">
                                    <a class="nav-link login-btn"
                                       data-bs-toggle="modal"
                                       data-bs-target="#sign-modal"
                                       href="#">Log In</a>
                                </li>
                            }

                        }
                        else
                        {
                            <script>
                                let userAuthorized = false;
                            </script>
                            <li class="nav-item">
                                <a class="nav-link login-btn"
                                   data-bs-toggle="modal"
                                   data-bs-target="#sign-modal"
                                   href="#">Log In</a>
                            </li>
                        }
                    }
                </ul>
                <!-- end of right -->
            </div>
        </nav>
    </section>
    <!-- end of topbar -->
