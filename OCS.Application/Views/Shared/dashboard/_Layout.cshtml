<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@ViewBag.Title - Dashboard</title>
    <!-- Custom fonts for this template-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:100,100i,300,300i,400,400i,500,500i,700,700i,900,900i" rel="stylesheet">
    <!-- bootstrap css -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Custom styles for this template-->
    <link href="~/Content/dashboard/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/Content/dashboard/css/custom.css" rel="stylesheet" />
    <link href="~/Content/form/vendor/datepicker/daterangepicker.css" rel="stylesheet" />
    <link href="~/Content/form/vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" />
    <link href="~/Content/form/vendor/select2/select2.min.css" rel="stylesheet" />
    <link href="~/Content/form/css/main.css" rel="stylesheet" />
    <link href="~/Content/toastr.css" rel="stylesheet" />
    <link href="~/Content/jquery.fancybox.css" rel="stylesheet" />
</head>
<body id="page-top">
    <!-- Page Wrapper -->
    <div id="wrapper">
        <!-- Sidebar -->
        @Html.Partial("dashboard/_Sidebar")
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            <div id="content">
                <!-- Topbar -->
                @Html.Partial("dashboard/_Topbar")
                <!-- End of Topbar -->
                <div class="body-content">
                    @RenderBody()
                </div>
            </div>
            <!-- End of Main Content -->
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2021</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->
        </div>
        <!-- End of Content Wrapper -->
    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal-->
    @Html.Partial("dashboard/_Logout-Modal")
    <!-- bootstrap js -->
    <script src="~/Content/dashboard/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/dashboard/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Content/dashboard/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/dashboard/vendor/chart/Chart.bundle.min.js"></script>
    <script src="~/Content/dashboard/js/sb-admin-2.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/bootbox.min.js"></script>

    <script src="~/Content/dashboard/Authentication/Auth.js"></script>
    @RenderSection("ViewSpecificJavascript", required: false)
</body>
</html>
