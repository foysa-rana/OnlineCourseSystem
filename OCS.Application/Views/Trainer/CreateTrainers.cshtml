@model OCS.Core.ViewModel.Trainer.TrainerView
@{
    ViewBag.Title = "Create Trainers";
    Layout = "~/Views/Shared/dashboard/_Layout.cshtml";
}

@*@section ViewSpecificCss {
    <!-- Icons font CSS-->
