
@{
    ViewBag.Title = "TraineeReport";
    Layout = "~/Views/Shared/dashboard/_Layout.cshtml";
}

<div class="form-template">
    <div class="page-wrapper font-robo">
        <div class="form-wrapper wrapper--w960">
            <div class="form-card form-card-2">
                <div class="form-card-heading"></div>
                <div class="form-card-body">
                    <h4 class="title">Generate Trainee Report</h4>
                    @using (Html.BeginForm())
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="trainee-report" id="all-trainee" value="all trainee">
                            <label class="form-check-label" for="all-trainee">
                                All Trainer list
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="trainee-report" id="individual-trainee" value="individual trainee">
                            <label class="form-check-label" for="individual-trainee">
                                Individual Trainee
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="trainee-report" id="trainee-by-position" value="trainee by course">
                            <label class="form-check-label" for="trainee-by-position">
                                Course wise Trainee
                            </label>
                        </div>
                        <div class="p-t-30">
                            <button class="form-btn form-btn--radius btn--green" type="button" id="trainee-report">
                                Run
                            </button>
                            <a class="d-none" id="pdf" runat="server">Click Me</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


